bool initializeBLE() {
  if (bleInitialized) return true;
  
#if !ENABLE_BLE
  Serial.println("[BLE] Disabled by config");
  bleInitialized = false;
  return true;
#endif

  Serial.printf("[HEAP] Before BLE init: %u bytes (Max Alloc: %u bytes)\n", 
                ESP.getFreeHeap(), ESP.getMaxAllocHeap());
  
  if (ESP.getMaxAllocHeap() < 100000) {
    Serial.printf("[BLE] ERROR: Heap too fragmented! Need 100KB, have %u bytes\n", 
                  ESP.getMaxAllocHeap());
    return false;
  }
  
  Serial.println("[BLE] Stabilizing heap (1000ms)...");
  delay(1000);
  esp_task_wdt_reset();
  
  if (ESP.getMaxAllocHeap() < 100000) {
    Serial.printf("[BLE] ERROR: Heap still fragmented after wait! Have %u bytes\n", 
                  ESP.getMaxAllocHeap());
    return false;
  }
  
  esp_task_wdt_reset();
  
  Serial.println("[BLE] Initializing device...");
  try {
    BLEDevice::init("PLTS_RAMLI343");
    esp_task_wdt_reset();
    
    pServer = BLEDevice::createServer();
    if (pServer == NULL) {
      Serial.println("[BLE] ERROR: Failed to create server");
      return false;
    }
    pServer->setCallbacks(new MyServerCallbacks());
    esp_task_wdt_reset();
    
    BLEService *pService = pServer->createService(SERVICE_UUID);
    if (pService == NULL) {
      Serial.println("[BLE] ERROR: Failed to create service");
      return false;
    }
    esp_task_wdt_reset();
    
    pCharWrite = pService->createCharacteristic(
      CHAR_WRITE_UUID, 
      BLECharacteristic::PROPERTY_WRITE | BLECharacteristic::PROPERTY_WRITE_NR
    );
    if (pCharWrite == NULL) {
      Serial.println("[BLE] ERROR: Failed to create write characteristic");
      return false;
    }
    pCharWrite->setCallbacks(new RelayCallbacks());
    esp_task_wdt_reset();
    
    pCharStatus = pService->createCharacteristic(
      CHAR_STATUS_UUID, 
      BLECharacteristic::PROPERTY_READ | BLECharacteristic::PROPERTY_NOTIFY
    );
    if (pCharStatus == NULL) {
      Serial.println("[BLE] ERROR: Failed to create status characteristic");
      return false;
    }
    pCharStatus->addDescriptor(new BLE2902());
    esp_task_wdt_reset();
    
    pService->start();
    BLEDevice::getAdvertising()->addServiceUUID(SERVICE_UUID);
    BLEDevice::startAdvertising();
    esp_coex_preference_set(ESP_COEX_PREFER_BALANCE);
    
    bleInitialized = true;
    Serial.println("[BLE] ✓ Initialization complete");
    return true;
    
  } catch (...) {
    Serial.println("[BLE] EXCEPTION during initialization!");
    bleInitialized = false;
    return false;
  }
}

