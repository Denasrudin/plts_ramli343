// ============================================================
// SENSOR READINGS
// ============================================================
float bacaTeganganPV() {
  if (!adsOK) return 0.0f;
  float sum = 0.0f;
  if (!TAKE_I2C((TickType_t)50)) return teganganPV;
  
  ads.setGain(GAIN_TWOTHIRDS);
  for (int i = 0; i < 5; i++) {
    int16_t adcRaw = ads.readADC_SingleEnded(ADS_CH_PV_VOLT);
    sum += adcRaw * 0.1875f / 1000.0f * PV_DIVIDER_RATIO * calibrationFactorPV;
    delayMicroseconds(800);
  }
  GIVE_I2C();
  
  float raw = sum / 5.0f;
  if (raw < 0.0f || raw < 15.0f) return 0.0f;
  if (raw > 160.0f) return teganganPV;
  return raw;
}

// ============================================================
// BACA TEGANGAN BATTERY - STABLE VERSION
// ============================================================
float bacaTeganganBaterai() {

  if (!adsOK) {
    batteryConnected = false;
    return 0.0f;
  }

  if (!TAKE_I2C((TickType_t)50)) {
    return teganganFiltered;
  }

  // ----------------------------------------------------------
  // ADS1115
  // GAIN_TWOTHIRDS = 0.1875 mV / bit
  // ----------------------------------------------------------
  ads.setGain(GAIN_TWOTHIRDS);

  int16_t rawSamples[BATT_READ_SAMPLES];

  long rawSum = 0;
  int validCount = 0;

  // ----------------------------------------------------------
  // Ambil beberapa RAW ADC
  // ----------------------------------------------------------
  for (int i = 0; i < BATT_READ_SAMPLES; i++) {

    int16_t raw = ads.readADC_SingleEnded(ADS_CH_BATT_VOLT);

    rawSamples[i] = raw;

    if (raw > 0) {
      rawSum += raw;
      validCount++;
    }

    delayMicroseconds(800);
  }

  GIVE_I2C();

  if (validCount == 0) {
    Serial.println("[BATT] Tidak ada RAW ADC valid");
    return teganganFiltered;
  }

  // ----------------------------------------------------------
  // RAW ADC average
  // ----------------------------------------------------------
  float rawADC =
      (float)rawSum / (float)validCount;

  // ----------------------------------------------------------
  // Konversi RAW -> tegangan ADC
  //
  // 0.1875mV/bit = 0.0001875V/bit
  // ----------------------------------------------------------
  float adcVoltage =
      rawADC * 0.0001875f;

  // ----------------------------------------------------------
  // ADC -> BATTERY
  //
  // Divider aktual hasil pengukuran:
  //
  // 0.820V -> 49.2V
  // rasio = 60
  //
  // calibrationFactorBatt sengaja tetap 1.0
  // ----------------------------------------------------------
  float batteryRawVoltage =
      adcVoltage * BATT_DIVIDER_RATIO;

  float batteryVoltage =
      batteryRawVoltage * calibrationFactorBatt;

  // ----------------------------------------------------------
  // VALIDASI
  // ----------------------------------------------------------
  if (!isfinite(batteryVoltage)) {
    Serial.println("[BATT] NaN/INF");
    return teganganFiltered;
  }

  if (batteryVoltage < BATT_MIN_VALID_VOLT ||
      batteryVoltage > BATT_MAX_VALID_VOLT) {

    Serial.printf(
      "[BATT] OUT OF RANGE: %.3f V\n",
      batteryVoltage
    );

    return teganganFiltered;
  }

  // ==========================================================
  // MEDIAN FILTER
  // ==========================================================

  static float medianSamples[BATT_MEDIAN_SAMPLES] = {0};

  static int medianIndex = 0;

  static bool medianInitialized = false;

  if (!medianInitialized) {

    for (int i = 0; i < BATT_MEDIAN_SAMPLES; i++) {
      medianSamples[i] = batteryVoltage;
    }

    medianInitialized = true;
    medianIndex = 0;

  } else {

    medianSamples[medianIndex] =
        batteryVoltage;

    medianIndex++;

    if (medianIndex >= BATT_MEDIAN_SAMPLES) {
      medianIndex = 0;
    }
  }

  float medianVoltage =
      hitungMedian(
        medianSamples,
        BATT_MEDIAN_SAMPLES
      );

  // ==========================================================
  // SPIKE PROTECTION
  // ==========================================================

  if (!teganganFilterInitialized) {

    teganganFiltered = medianVoltage;

  } else {

    float difference =
        medianVoltage - teganganFiltered;

    // Jika lonjakan sangat besar hanya satu pembacaan,
    // jangan langsung masukkan seluruh lonjakan ke filter.
    if (fabs(difference) > BATT_MAX_STEP_V) {

      Serial.printf(
        "[BATT] SPIKE DITAHAN: %.3f -> %.3f V\n",
        teganganFiltered,
        medianVoltage
      );

      if (difference > 0) {
        medianVoltage =
            teganganFiltered + BATT_MAX_STEP_V;
      } else {
        medianVoltage =
            teganganFiltered - BATT_MAX_STEP_V;
      }
    }
  }

  // ==========================================================
  // EMA FILTER
  // ==========================================================

  if (!teganganFilterInitialized) {

    teganganFiltered =
        medianVoltage;

    teganganFilterInitialized = true;

  } else {

    teganganFiltered =
        (BATT_EMA_ALPHA * medianVoltage) +
        ((1.0f - BATT_EMA_ALPHA) *
         teganganFiltered);
  }

  // ----------------------------------------------------------
  // Safety
  // ----------------------------------------------------------
  if (!isfinite(teganganFiltered)) {
    teganganFiltered = 0.0f;
    teganganFilterInitialized = false;
    batteryConnected = false;
    return 0.0f;
  }

  teganganFiltered =
      constrain(
        teganganFiltered,
        0.0f,
        BATT_MAX_VALID_VOLT
      );

  // ----------------------------------------------------------
  // Battery connected
  // ----------------------------------------------------------
  batteryConnected =
      (teganganFiltered >= 20.0f);

  // ==========================================================
  // DEBUG
  // ==========================================================

  static unsigned long lastBattDebug = 0;

  unsigned long now = millis();

  if (now - lastBattDebug >= BATT_DEBUG_INTERVAL_MS) {

    lastBattDebug = now;

    Serial.println(
      "[BATT] --------------------------------"
    );

    Serial.printf(
      "[BATT] RAW ADC       : %.1f\n",
      rawADC
    );

    Serial.printf(
      "[BATT] ADC VOLT      : %.6f V\n",
      adcVoltage
    );

    Serial.printf(
      "[BATT] DIVIDER       : %.2f\n",
      BATT_DIVIDER_RATIO
    );

    Serial.printf(
      "[BATT] BEFORE CAL    : %.3f V\n",
      batteryRawVoltage
    );

    Serial.printf(
      "[BATT] CAL FACTOR    : %.6f\n",
      calibrationFactorBatt
    );

    Serial.printf(
      "[BATT] FINAL RAW     : %.3f V\n",
      batteryVoltage
    );

    Serial.printf(
      "[BATT] MEDIAN        : %.3f V\n",
      medianVoltage
    );

    Serial.printf(
      "[BATT] FILTERED      : %.3f V\n",
      teganganFiltered
    );

    Serial.printf(
      "[BATT] CONNECTED     : %s\n",
      batteryConnected ? "YES" : "NO"
    );

    Serial.println(
      "[BATT] --------------------------------"
    );
  }

  return teganganFiltered;
}

float bacaShuntChannel(ShuntChannel channel) {
  if (!adsOK || !batteryConnected) 
    return (channel == SHUNT_INPUT) ? arusInputFiltered : arusLoadFiltered;
    
  if (!TAKE_I2C((TickType_t)50)) 
    return (channel == SHUNT_INPUT) ? arusInputFiltered : arusLoadFiltered;

  ads.setGain(GAIN_SIXTEEN);
  int adsChannel = (channel == SHUNT_INPUT) ? ADS_CH_SHUNT_INPUT : ADS_CH_SHUNT_LOAD;
  float sumShunt = 0.0f;
  float sumCurrent = 0.0f;

  for (int i = 0; i < 5; i++) {
    int16_t adcRaw = ads.readADC_SingleEnded(adsChannel);
    float shunt_mV = adcRaw * 0.0078125f;
    sumShunt += shunt_mV;
    sumCurrent += (shunt_mV / SHUNT_MV_PER_A) * calibrationFactorArus;
    delayMicroseconds(800);
  }
  GIVE_I2C();

  float shuntRaw = sumShunt / 5.0f;
  float offset = (channel == SHUNT_INPUT) ? arusInputOffset : arusLoadOffset;
  float rawCurrent = (sumCurrent / 5.0f) - offset;
  rawCurrent = fabs(rawCurrent);
  rawCurrent = constrain(rawCurrent, 0.0f, 100.0f);
  if (rawCurrent < ARUS_IDLE_THRESHOLD) rawCurrent = 0.0f;

  if (channel == SHUNT_INPUT) {
    if (!shuntInputFilterInitialized) {
      for (int i = 0; i < FILTER_SAMPLES; i++) shuntInputSamples[i] = shuntRaw;
      shuntInput_mVFiltered = shuntRaw; 
      shuntInputFilterInitialized = true; 
      shuntInputIndex = 0;
    } else {
      shuntInputSamples[shuntInputIndex] = shuntRaw;
      shuntInputIndex = (shuntInputIndex + 1) % FILTER_SAMPLES;
      shuntInput_mVFiltered = EMA_ALPHA_SHUNT * hitungMedian(shuntInputSamples, FILTER_SAMPLES) + 
                              (1.0f - EMA_ALPHA_SHUNT) * shuntInput_mVFiltered;
    }
    if (!arusInputFilterInitialized) {
      for (int i = 0; i < FILTER_SAMPLES; i++) arusInputSamples[i] = rawCurrent;
      arusInputFiltered = rawCurrent; 
      arusInputFilterInitialized = true; 
      arusInputIndex = 0;
    } else {
      arusInputSamples[arusInputIndex] = rawCurrent;
      arusInputIndex = (arusInputIndex + 1) % FILTER_SAMPLES;
      arusInputFiltered = EMA_ALPHA_ARUS * hitungMedian(arusInputSamples, FILTER_SAMPLES) + 
                          (1.0f - EMA_ALPHA_ARUS) * arusInputFiltered;
    }
    if (fabs(arusInputFiltered) < ARUS_IDLE_THRESHOLD) arusInputFiltered = 0.0f;
    return arusInputFiltered;
  }

  if (!shuntLoadFilterInitialized) {
    for (int i = 0; i < FILTER_SAMPLES; i++) shuntLoadSamples[i] = shuntRaw;
    shuntLoad_mVFiltered = shuntRaw; 
    shuntLoadFilterInitialized = true; 
    shuntLoadIndex = 0;
  } else {
    shuntLoadSamples[shuntLoadIndex] = shuntRaw;
    shuntLoadIndex = (shuntLoadIndex + 1) % FILTER_SAMPLES;
    shuntLoad_mVFiltered = EMA_ALPHA_SHUNT * hitungMedian(shuntLoadSamples, FILTER_SAMPLES) + 
                           (1.0f - EMA_ALPHA_SHUNT) * shuntLoad_mVFiltered;
  }
  if (!arusLoadFilterInitialized) {
    for (int i = 0; i < FILTER_SAMPLES; i++) arusLoadSamples[i] = rawCurrent;
    arusLoadFiltered = rawCurrent; 
    arusLoadFilterInitialized = true; 
    arusLoadIndex = 0;
  } else {
    arusLoadSamples[arusLoadIndex] = rawCurrent;
    arusLoadIndex = (arusLoadIndex + 1) % FILTER_SAMPLES;
    arusLoadFiltered = EMA_ALPHA_ARUS * hitungMedian(arusLoadSamples, FILTER_SAMPLES) + 
                       (1.0f - EMA_ALPHA_ARUS) * arusLoadFiltered;
  }
  if (fabs(arusLoadFiltered) < ARUS_IDLE_THRESHOLD) arusLoadFiltered = 0.0f;
  return arusLoadFiltered;
}

// ============================================================
// POLL CONFIG FROM SUPABASE
// ============================================================
void pollRelayConfigFromServer() {
  if (WiFi.status() != WL_CONNECTED) return;
  if (!TAKE_HTTP(0)) return;
  if (httpBusy) { 
    GIVE_HTTP(); 
    return; 
  }
  
  httpBusy = true;
  String url = String(SUPABASE_URL) + "/rest/v1/" + CONFIG_TABLE +
               "?id=eq.1&select=relay1_mode,relay2_mode," +
               "hf_on_amp,hf_off_amp,hf_stable_time," +
               "calib_factor_batt,calib_factor_pv,arus_offset,arus_gain," +
               "volt_cutoff_lf,volt_restore_lf,pv_interlock_volt";

  globalSecureClient.setInsecure();
  globalSecureClient.setTimeout(8);
  HTTPClient http;
  http.setConnectTimeout(HTTP_CONNECT_TIMEOUT_MS);
  http.setTimeout(HTTP_TIMEOUT_MS);
  http.setReuse(false);

  if (http.begin(globalSecureClient, url)) {
    http.addHeader("apikey", SUPABASE_KEY);
    http.addHeader("Authorization", "Bearer " + String(SUPABASE_KEY));
    int httpCode = http.GET();

    if (httpCode == 200) {
      serverOnline = true;
      String payload = http.getString();
      if (payload.length() > 2) {
        StaticJsonDocument<768> doc;
        DeserializationError err = deserializeJson(doc, payload);
        if (!err && doc.is<JsonArray>() && doc.size() > 0) {
          JsonObject row = doc[0];

          const char* r1mode = row["relay1_mode"] | "AUTO";
          const char* r2mode = row["relay2_mode"] | "AUTO";
          bool newR1Auto = (strcmp(r1mode, "AUTO") == 0);
          bool newR1State = (strcmp(r1mode, "ON") == 0);
          bool newR2Auto = (strcmp(r2mode, "AUTO") == 0);
          bool newR2State = (strcmp(r2mode, "ON") == 0);

          float hfOn = row["hf_on_amp"] | HF_ON_AMP;
          float hfOff = row["hf_off_amp"] | HF_OFF_AMP;
          unsigned long hfStable = (unsigned long)(row["hf_stable_time"] | (int)HF_STABLE_TIME_MS);
          if (hfOn > 0) HF_ON_AMP = hfOn;
          if (hfOff > 0) HF_OFF_AMP = hfOff;
          if (hfStable > 0) HF_STABLE_TIME_MS = hfStable;

          float lfOn = row["volt_cutoff_lf"] | LF_BATT_ON_V;
          float lfOff = row["volt_restore_lf"] | LF_BATT_OFF_V;
          float pvOv = row["pv_interlock_volt"] | PV_OVERRIDE_V;
          if (lfOn > 0) LF_BATT_ON_V = lfOn;
          if (lfOff > 0) LF_BATT_OFF_V = lfOff;
          if (pvOv > 0) PV_OVERRIDE_V = pvOv;

          float configCalibBatt = row["calib_factor_batt"] | calibrationFactorBatt;
          float configCalibPV = row["calib_factor_pv"] | calibrationFactorPV;
          float configArusOffset = row["arus_offset"] | arusOffset;
          float configArusGain = row["arus_gain"] | calibrationFactorArus;
          if (configCalibBatt > 0.5f && configCalibBatt < 1.5f) calibrationFactorBatt = configCalibBatt;
          if (configCalibPV > 0.5f && configCalibPV < 1.5f) calibrationFactorPV = configCalibPV;
          if (configArusOffset >= -20.0f && configArusOffset <= 20.0f) arusOffset = configArusOffset;
          if (configArusGain > 0.5f && configArusGain < 1.5f) calibrationFactorArus = configArusGain;

          unsigned long now = millis();
          if (relay1Auto != newR1Auto || (!relay1Auto && pln1Aktif != newR1State)) {
            if (now - lastRelay1Switch >= RELAY_COOLDOWN_MS) {
              relay1Auto = newR1Auto;
              if (!relay1Auto && teganganPV < PV_OVERRIDE_V) {
                pln1Aktif = newR1State;
                digitalWrite(RELAY1_PIN, pln1Aktif ? LOW : HIGH);
                lastRelay1Switch = now;
                Serial.printf("[SERVER] Relay1 -> %s\n", r1mode);
              }
            }
          }
          if (relay2Auto != newR2Auto || (!relay2Auto && pln2Aktif != newR2State)) {
            if (now - lastRelay2Switch >= RELAY_COOLDOWN_MS) {
              relay2Auto = newR2Auto;
              if (!relay2Auto && teganganPV < PV_OVERRIDE_V) {
                pln2Aktif = newR2State;
                digitalWrite(RELAY2_PIN, pln2Aktif ? LOW : HIGH);
                lastRelay2Switch = now;
                Serial.printf("[SERVER] Relay2 -> %s\n", r2mode);
              }
            }
          }
        }
      }
    } else {
      serverOnline = false;
      Serial.printf("[SERVER] Poll config HTTP %d\n", httpCode);
    }
    http.end();
  } else {
    serverOnline = false;
  }

  httpBusy = false;
  GIVE_HTTP();
}

// ============================================================
// SEND DATA TO SUPABASE
// ============================================================
void supabaseTaskFn(void *pvParameters) {
  esp_task_wdt_add(NULL);
  for (;;) {
    esp_task_wdt_reset();
    if (WiFi.status() == WL_CONNECTED) sendDataToSupabase();
    vTaskDelay(pdMS_TO_TICKS(INTERVAL_KIRIM_MS));
  }
}

void sendDataToSupabase() {
  if (WiFi.status() != WL_CONNECTED || ESP.getFreeHeap() < 15000) return;
  if (!TAKE_HTTP(pdMS_TO_TICKS(100))) return;
  if (httpBusy) { 
    GIVE_HTTP(); 
    return; 
  }

  httpBusy = true;
  esp_coex_preference_set(ESP_COEX_PREFER_WIFI);
  bool success = false;

  for (int attempt = 1; attempt <= HTTP_MAX_RETRY; attempt++) {
    if (attempt > 1) {
      int delayMs = 1000 * (1 << (attempt - 1));
      vTaskDelay(pdMS_TO_TICKS(delayMs));
    }
    esp_task_wdt_reset();

    StaticJsonDocument<320> doc;
    doc["firmware"] = CURRENT_FIRMWARE_VERSION;
    doc["tegangan"] = batteryConnected ? teganganFiltered : 0.0f;
    doc["arus_input"] = batteryConnected ? arusInputFiltered : 0.0f;
    doc["arus_load"] = batteryConnected ? arusLoadFiltered : 0.0f;
    doc["arus"] = batteryConnected ? arusLoadFiltered : 0.0f;
    doc["daya"] = batteryConnected ? (teganganFiltered * arusLoadFiltered) : 0.0f;
    doc["pv_voltage"] = teganganPV;
    doc["pln_aktif"] = pln1Aktif;
    doc["pln2_aktif"] = pln2Aktif;
    doc["sensor_ok"] = adsOK;
    doc["battery_connected"] = batteryConnected;

    String jsonData;
    serializeJson(doc, jsonData);

    String url = String(SUPABASE_URL) + "/rest/v1/" + SUPABASE_TABLE;
    globalSecureClient.setInsecure();
    globalSecureClient.setTimeout(8);
    HTTPClient http;
    http.setConnectTimeout(HTTP_CONNECT_TIMEOUT_MS);
    http.setTimeout(HTTP_TIMEOUT_MS);
    http.setReuse(false);

    if (http.begin(globalSecureClient, url)) {
      http.addHeader("Content-Type", "application/json");
      http.addHeader("Host", SUPABASE_HOST);
      http.addHeader("apikey", SUPABASE_KEY);
      http.addHeader("Authorization", "Bearer " + String(SUPABASE_KEY));
      http.addHeader("Prefer", "return=minimal");

      int httpCode = http.POST(jsonData);
      http.end();

      if (httpCode >= 200 && httpCode < 300) {
        success = true;
        serverOnline = true;
        Serial.printf("[HTTP] OK %d\n", httpCode);
        break;
      } else {
        Serial.printf("[HTTP] FAIL %d attempt %d\n", httpCode, attempt);
        if (attempt == HTTP_MAX_RETRY) serverOnline = false;
      }
    }
    esp_task_wdt_reset();
  }

  esp_coex_preference_set(ESP_COEX_PREFER_BALANCE);
  httpBusy = false;
  GIVE_HTTP();
}
