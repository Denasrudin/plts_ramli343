    server.send(200, "text/html", html);
  });

  // ==========================================================
  // OTA STATUS
  // ==========================================================
  server.on("/ota-status", HTTP_GET, []() {
    String json;
    json.reserve(256);
    json = "{\"status\":\"online\",\"firmware\":\"";
    json += CURRENT_FIRMWARE_VERSION;
    json += "\",\"heap\":";
    json += String(ESP.getFreeHeap());
    json += ",\"uptime\":";
    json += String(millis());
    json += "}";
    server.send(200, "application/json", json);
  });

  // ==========================================================
  // OTA POST
  // ==========================================================
  server.on("/update", HTTP_POST,
    []() {
      if(!otaFileNameValid){
        Serial.println("[OTA] MAAF, FILE SALAH!");
        server.send(400, "text/plain", "Maaf, file salah!");
        return;
      }
      if(!otaStarted){
        Serial.println("[OTA] OTA tidak dimulai.");
        server.send(500, "text/plain", "OTA tidak dimulai.");
        return;
      }
      if(otaWriteError || Update.hasError()){
        Serial.println("[OTA] Upload GAGAL!");
        server.send(500, "text/plain", "Upload GAGAL! Cek Serial Monitor.");
        return;
      }

      Serial.println();
      Serial.println("[OTA] ==================================");
      Serial.println("[OTA] UPLOAD BERHASIL!");
      Serial.println("[OTA] FIRMWARE VALID!");
      Serial.printf("[OTA] Total diterima: %u bytes\n", otaReceived);
      Serial.println("[OTA] HTTP response dikirim.");
      Serial.println("[OTA] ==================================");

      server.send(200, "text/plain", "Upload BERHASIL! Firmware valid. Box Sensor akan restart...");
      delay(1200);
      Serial.println("[OTA] RESTART Box Sensor...");
      delay(200);
      ESP.restart();
    },
    []() {
      HTTPUpload& upload = server.upload();

      if(upload.status == UPLOAD_FILE_START){
        otaFileNameValid = false;
        otaStarted = false;
        otaWriteError = false;
        otaReceived = 0;
        otaLastProgress = millis();

        Serial.println();
        Serial.println("[OTA] ==================================");
        Serial.printf("[OTA] Nama file diterima: %s\n", upload.filename.c_str());

        if(upload.filename != "update_plts.bin"){
          Serial.println("[OTA] MAAF, FILE SALAH!");
          Serial.println("[OTA] Upload DITOLAK.");
          Serial.println("[OTA] ==================================");
          otaFileNameValid = false;
          otaStarted = false;
          return;
        }

        otaFileNameValid = true;
        Serial.println("[OTA] Nama file benar.");
        Serial.printf("[OTA] Free Heap      : %u bytes\n", ESP.getFreeHeap());
        Serial.printf("[OTA] Max Alloc Heap : %u bytes\n", ESP.getMaxAllocHeap());

        if(ESP.getMaxAllocHeap() < 30000){
          Serial.printf("[OTA] Max continuous heap terlalu rendah: %u\n", ESP.getMaxAllocHeap());
          otaStarted = false;
          return;
        }

        if(!Update.begin(UPDATE_SIZE_UNKNOWN)){
          Serial.print("[OTA] Error Update.begin: ");
          Update.printError(Serial);
          otaStarted = false;
          return;
        }
        otaStarted = true;
        Serial.println("[OTA] Update.begin OK");
      }
      else if(upload.status == UPLOAD_FILE_WRITE){
        if(!otaFileNameValid || !otaStarted || otaWriteError) return;

        if(ESP.getFreeHeap() < 5000){
          Serial.printf("[OTA] WARNING Heap rendah: %u bytes\n", ESP.getFreeHeap());
          delay(10);
          yield();
        }

        size_t written = Update.write(upload.buf, upload.currentSize);
        otaReceived += written;

        if(written != upload.currentSize){
          otaWriteError = true;
          Serial.printf("[OTA] Update.write ERROR: wrote %u of %u bytes, error=%d\n",
                        written, upload.currentSize, Update.getError());
          Update.printError(Serial);
          return;
        }

        if(millis() - otaLastProgress >= 500){
          otaLastProgress = millis();
          Serial.printf("[OTA] Received: %u bytes | Heap: %u\n", otaReceived, ESP.getFreeHeap());
        }
        yield();
      }
      else if(upload.status == UPLOAD_FILE_END){
        if(!otaFileNameValid || !otaStarted){
          Serial.println("[OTA] File tidak valid. OTA dibatalkan.");
          return;
        }
        if(otaWriteError){
          Serial.println("[OTA] Write error. OTA dibatalkan.");
          Update.end();
          otaStarted = false;
          return;
        }

        Serial.println();
        Serial.printf("[OTA] Upload selesai. Total: %u bytes\n", otaReceived);

        if(Update.end(true)){
          Serial.println("[OTA] ==================================");
          Serial.println("[OTA] FIRMWARE VALID!");
          Serial.printf("[OTA] Total ukuran: %u bytes\n", otaReceived);
          Serial.println("[OTA] Menunggu HTTP response...");
          Serial.println("[OTA] ==================================");
        }else{
          otaWriteError = true;
          Serial.print("[OTA] Error Update.end: ");
          Update.printError(Serial);
        }
      }
      else if(upload.status == UPLOAD_FILE_ABORTED){
        Serial.println("[OTA] Upload dibatalkan.");
        if(otaStarted) Update.end();
        otaStarted = false;
        otaFileNameValid = false;
        otaWriteError = true;
      }
    }
  );

  server.begin();
  webServerStarted = true;

  Serial.println("[WEB] ==================================");
  Serial.println("[WEB] OTA Web Server DIMULAI");
  Serial.printf("[WEB] IP: http://%s\n", WiFi.localIP().toString().c_str());
  Serial.println("[WEB] ==================================");
}

// ============================================================
// SETUP
// ============================================================
void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println();
  Serial.println("========================================");
  Serial.printf(" PLTS RAMLI 343 %s FINAL\n", CURRENT_FIRMWARE_VERSION);
  Serial.println(" Dual Shunt A2/A3 + Logika Relay Final");
  Serial.println(" BLE AKTIF SEJAK AWAL UNTUK KONFIGURASI");
  Serial.println(" OTA: Web Server Mandiri (Browser)");
  Serial.println("========================================");

  esp_task_wdt_config_t wdt_config = {
    .timeout_ms = 30000,
    .idle_core_mask = 0,
    .trigger_panic = true
  };
  esp_task_wdt_reconfigure(&wdt_config);
  esp_task_wdt_add(NULL);

  nvs_flash_init();
  WiFi.onEvent(WiFiEvent);

  pinMode(RELAY1_PIN, OUTPUT);
  pinMode(RELAY2_PIN, OUTPUT);
  digitalWrite(RELAY1_PIN, HIGH);
  digitalWrite(RELAY2_PIN, HIGH);
  delay(300);

  if (!initializeMutexes()) {
    Serial.println("[FATAL] Mutex initialization failed! Rebooting...");
    delay(2000);
    ESP.restart();
  }
  esp_task_wdt_reset();

  Wire.begin(I2C_SDA, I2C_SCL);
  Wire.setClock(100000);
  delay(300);
  scanI2C();

  if (TAKE_I2C((TickType_t)100)) {
    lcd.begin(16, 2);
    lcd.setBacklight(0);
    lcd.clear();
    lcd.print("INITIALIZING...");
    GIVE_I2C();
  }
  delay(300);

  adsOK = ads.begin(ADS1115_ADDR);
  Serial.printf("[STARTUP] ADS1115: %s\n", adsOK ? "OK" : "FAIL");
  delay(300);
  esp_task_wdt_reset();

  if (ENABLE_BLE) {
    if (!initializeBLE()) {
      Serial.println("[WARNING] BLE init failed, will retry later in loop");
      bleInitialized = false;
    }
  }
  esp_task_wdt_reset();

  preferences.begin("plts", false);
  String ssid = preferences.getString("ssid", "");
  String pass = preferences.getString("pass", "");
  preferences.end();

  if (ssid.length() > 0) {
    if (connectWiFi(ssid, pass)) {
      delay(500);
      syncTimeNTP();
    } else {
      startWiFiReconnect();
    }
  } else {
    Serial.println("[WiFi] No saved SSID - waiting for BLE configuration");
  }
  esp_task_wdt_reset();

  if (adsOK) {
    Serial.println("[CAL] Calibrating A2/A3 offsets...");
    ads.setGain(GAIN_SIXTEEN);
    delay(300);
    float inputOffsetSum = 0.0f;
    float loadOffsetSum = 0.0f;
    for (int i = 0; i < 20; i++) {
      esp_task_wdt_reset();
      if (!TAKE_I2C((TickType_t)50)) continue;
      int16_t rawInput = ads.readADC_SingleEnded(ADS_CH_SHUNT_INPUT);
      delayMicroseconds(800);
      int16_t rawLoad = ads.readADC_SingleEnded(ADS_CH_SHUNT_LOAD);
      GIVE_I2C();
      float input_mV = rawInput * 0.0078125f;
      float load_mV = rawLoad * 0.0078125f;
      inputOffsetSum += (input_mV / SHUNT_MV_PER_A) * calibrationFactorArus;
      loadOffsetSum += (load_mV / SHUNT_MV_PER_A) * calibrationFactorArus;
      delay(30);
    }
    arusInputOffset = inputOffsetSum / 20.0f;
    arusLoadOffset = loadOffsetSum / 20.0f;
    if (fabs(arusInputOffset) > 2.0f) arusInputOffset = 0.0f;
    if (fabs(arusLoadOffset) > 2.0f) arusLoadOffset = 0.0f;
    Serial.printf("[CAL] A2 INPUT Offset: %.4fA\n", arusInputOffset);
    Serial.printf("[CAL] A3 LOAD Offset: %.4fA\n", arusLoadOffset);
    
    for (int i = 0; i < FILTER_SAMPLES; i++) {
      arusInputSamples[i] = 0.0f;
      arusLoadSamples[i] = 0.0f;
      shuntInputSamples[i] = 0.0f;
      shuntLoadSamples[i] = 0.0f;
    }
  }
  esp_task_wdt_reset();

  if (TAKE_I2C((TickType_t)100)) {
    lcd.setBacklight(200);
    GIVE_I2C();
  }

  if (ENABLE_SUPABASE) {
    xTaskCreate(supabaseTaskFn, "SupabaseTask", 16384, NULL, 1, NULL);
  }

  Serial.printf("[HEAP] Free: %u bytes | Max Alloc: %u bytes\n", 
                ESP.getFreeHeap(), ESP.getMaxAllocHeap());
  Serial.println("=== INIT COMPLETE ===\n");

  currentLcdPage = 0;
  lastLcdPage = -1;
  lcdPageStartTime = millis();
  scrollOffset = 0;
  scrollPassCount = 0;
  lastScrollTime = millis();
  updateLcdDisplay();
}

// ============================================================
// MAIN LOOP
// ============================================================
void loop() {
  esp_task_wdt_reset();
  unsigned long now = millis();

  static unsigned long lastBleRetry = 0;
  if (!bleInitialized && ENABLE_BLE && (now - lastBleRetry >= 30000)) {
    lastBleRetry = now;
    Serial.println("[BLE] Retrying BLE initialization...");
    if (initializeBLE()) {
      Serial.println("[BLE] BLE initialized successfully on retry");
    } else {
      Serial.println("[BLE] BLE retry failed, will try again later");
    }
  }

  static bool webServerDeferredDone = false;
  if (!webServerDeferredDone && WiFi.status() == WL_CONNECTED) {
    if (ESP.getMaxAllocHeap() >= 30000) {
      Serial.println("[INIT] Starting deferred WebServer...");
      setupWebServer();
      webServerDeferredDone = true;
    } else {
      static unsigned long lastHeapLog = 0;
      if (now - lastHeapLog > 10000) {
        Serial.printf("[INIT] Deferred WebServer: heap max alloc = %u, need 30000\n", ESP.getMaxAllocHeap());
        lastHeapLog = now;
      }
    }
  }

  if (webServerStarted) {
    server.handleClient();
  }

  static unsigned long lastHeartbeat = 0;
  if (now - lastHeartbeat > 10000) {
    Serial.printf("[HEARTBEAT] Heap:%u | BATT:%.2fV | PV:%.1fV | IN:%.2fA | LOAD:%.2fA | SHUNT:%s | LF:%s | HF:%s | WiFi:%s | Server:%s | RSSI:%d | BLE:%s\n",
                  ESP.getFreeHeap(), teganganFiltered, teganganPV,
                  arusInputFiltered, arusLoadFiltered,
                  activeShuntChannel == SHUNT_INPUT ? "A2" : "A3",
                  pln1Aktif ? "PLN" : "PLTS", pln2Aktif ? "PLN" : "PLTS",
                  WiFi.status() == WL_CONNECTED ? "OK" : "OFF",
                  serverOnline ? "ONLINE" : "OFFLINE",
                  WiFi.status() == WL_CONNECTED ? WiFi.RSSI() : 0,
                  bleInitialized ? (bleConnected ? "CONN" : "ADV") : "OFF");
    lastHeartbeat = now;
  }

  serviceWiFiReconnect();
  serviceTimeSync();

  if (WiFi.status() != WL_CONNECTED && !wifiReconnectPending && now - lastReconnect >= WIFI_RECONNECT_INTERVAL) {
    lastReconnect = now;
    startWiFiReconnect();
  }

  teganganPV = bacaTeganganPV();
  bacaTeganganBaterai();

  if (now - lastShuntSwitch >= SHUNT_SWITCH_INTERVAL_MS || lastShuntSwitch == 0) {
    lastShuntSwitch = now;
    if (activeShuntChannel == SHUNT_INPUT) {
      bacaShuntChannel(SHUNT_INPUT);
      activeShuntChannel = SHUNT_LOAD;
    } else {
      bacaShuntChannel(SHUNT_LOAD);
      activeShuntChannel = SHUNT_INPUT;
    }
  }

  kontrolRelay();

  static unsigned long lastPollRelay = 0;
  if (WiFi.status() == WL_CONNECTED && now - lastPollRelay >= SERVER_POLL_INTERVAL_MS) {
    lastPollRelay = now;
    pollRelayConfigFromServer();
  }

  if (timeSynced) {
    char tanggal[40];
    formatTanggalIndonesia(tanggal, sizeof(tanggal), time(nullptr));
    String cuaca;
    if (isWeatherTime()) {
      if (teganganPV < 70.0f) cuaca = " CUACA:BLM MENDUKUNG";
      else if (teganganPV < 110.0f) cuaca = " CUACA:PANAS";
      else cuaca = " CUACA:PANAS BANGET";
    } else {
      cuaca = " CUACA:CHG PV BELUM SIAP";
    }
    snprintf(dateTimeStr, sizeof(dateTimeStr), "%s%s", tanggal, cuaca.c_str());
  } else {
    strcpy(dateTimeStr, "--:--:-- --/--/---- NTP BELUM SYNC");
  }

  bool bothAuto = relay1Auto && relay2Auto;
  bool wifiOK = (WiFi.status() == WL_CONNECTED);
  bool anyOffline = !wifiOK || !timeSynced;

  if (!bothAuto && currentLcdPage != 2) {
    currentLcdPage = 2; 
    lcdPageStartTime = now; 
    scrollOffset = 0; 
    scrollPassCount = 0;
  } else if (anyOffline && currentLcdPage != 3) {
    currentLcdPage = 3; 
    lcdPageStartTime = now; 
    scrollOffset = 0; 
    scrollPassCount = 0;
  } else if (bothAuto && !anyOffline) {
    if (currentLcdPage == 0) {
      if (now - lastScrollTime >= SCROLL_INTERVAL_MS) {
        lastScrollTime = now;
        int len = strlen(dateTimeStr);
        if (len > 0) {
          scrollOffset++;
          if (scrollOffset >= len) {
            scrollPassCount++;
            if (scrollPassCount >= 1) {
              currentLcdPage = 1; 
              lcdPageStartTime = now; 
              scrollOffset = 0; 
              scrollPassCount = 0;
            }
          }
        }
      }
    } else {
      if (now - lcdPageStartTime >= PAGE_DURATION_OTHER) {
        currentLcdPage = (currentLcdPage + 1) % TOTAL_PAGES;
        lcdPageStartTime = now; 
        scrollOffset = 0; 
        scrollPassCount = 0;
      }
    }
  }

  if (now - lastLcdUpdate >= LCD_INTERVAL_UPDATE) {
    lastLcdUpdate = now;
    updateLcdDisplay();
  }

  delay(10);
}

// ============================================================
// RELAY CONTROL
// ============================================================
void kontrolRelay() {
  unsigned long now = millis();
  float arusLoadAbs = fabs(arusLoadFiltered);
  static bool hfHighArusStable = false;
  static unsigned long hfHighArusStartTime = 0;
  static bool pvStableHigh = false;
  static unsigned long pvStableStartTime = 0;
  static bool pvOverrideActive = false;

  if (teganganPV >= PV_OVERRIDE_V) {
    if (!pvStableHigh) { 
      pvStableHigh = true; 
      pvStableStartTime = now; 
    }
    else if ((now - pvStableStartTime) >= PV_STABLE_TIME_MS) {
      if (!pvOverrideActive) { 
        pvOverrideActive = true; 
        Serial.println("[PV] STABIL 5 MENIT → SEMUA RELAY OFF"); 
      }
    }
  } else {
    pvStableHigh = false; 
    pvStableStartTime = 0; 
    pvOverrideActive = false;
  }

  if (pvOverrideActive) {
    if (relay1Auto && pln1Aktif && (now - lastRelay1Switch >= RELAY_COOLDOWN_MS)) {
      digitalWrite(RELAY1_PIN, HIGH); 
      pln1Aktif = false; 
      lastRelay1Switch = now; 
      Serial.println("[LF] OFF (PV Override)");
    }
    if (relay2Auto && pln2Aktif && (now - lastRelay2Switch >= RELAY_COOLDOWN_MS)) {
      digitalWrite(RELAY2_PIN, HIGH); 
      pln2Aktif = false; 
      lastRelay2Switch = now; 
      Serial.println("[HF] OFF (PV Override)");
    }
    return;
  }

  bool batteryLow = (batteryConnected && teganganFiltered <= LF_BATT_ON_V);
  bool batteryHigh = (batteryConnected && teganganFiltered >= LF_BATT_OFF_V);

  if (batteryLow) {
    if (relay1Auto && !pln1Aktif && (now - lastRelay1Switch >= RELAY_COOLDOWN_MS)) {
      digitalWrite(RELAY1_PIN, LOW); 
      pln1Aktif = true; 
      lastRelay1Switch = now;
      Serial.printf("[LF] ON (BATT=%.2fV ≤ %.1f)\n", teganganFiltered, LF_BATT_ON_V);
    }
  } else if (batteryHigh) {
    if (relay1Auto && pln1Aktif && (now - lastRelay1Switch >= RELAY_COOLDOWN_MS)) {
      digitalWrite(RELAY1_PIN, HIGH); 
      pln1Aktif = false; 
      lastRelay1Switch = now;
      Serial.printf("[LF] OFF (BATT=%.2fV ≥ %.1f)\n", teganganFiltered, LF_BATT_OFF_V);
    }
  }

  bool lfIsOn = pln1Aktif;
  if (lfIsOn) {
    if (arusLoadAbs < HF_ON_AMP) {
      if (relay2Auto && !pln2Aktif && (now - lastRelay2Switch >= RELAY_COOLDOWN_MS)) {
        digitalWrite(RELAY2_PIN, LOW); 
        pln2Aktif = true; 
        lastRelay2Switch = now;
        Serial.printf("[HF] ON (LF ON & ARUS=%.1fA < %.1fA)\n", arusLoadAbs, HF_ON_AMP);
      }
    }
    if (arusLoadAbs >= HF_OFF_AMP) {
      if (!hfHighArusStable) { 
        hfHighArusStable = true; 
        hfHighArusStartTime = now; 
      }
      if (hfHighArusStable && (now - hfHighArusStartTime >= HF_STABLE_TIME_MS)) {
        if (relay2Auto && pln2Aktif && (now - lastRelay2Switch >= RELAY_COOLDOWN_MS)) {
          digitalWrite(RELAY2_PIN, HIGH); 
          pln2Aktif = false; 
          lastRelay2Switch = now;
          Serial.printf("[HF] OFF (ARUS=%.1fA ≥ %.1fA STABIL 3D)\n", arusLoadAbs, HF_OFF_AMP);
        }
        hfHighArusStable = false; 
        hfHighArusStartTime = 0;
      }
    } else {
      hfHighArusStable = false; 
      hfHighArusStartTime = 0;
    }
  } else {
    if (relay2Auto && pln2Aktif && (now - lastRelay2Switch >= RELAY_COOLDOWN_MS)) {
      digitalWrite(RELAY2_PIN, HIGH); 
      pln2Aktif = false; 
      lastRelay2Switch = now; 
      Serial.println("[HF] OFF (LF OFF)");
    }
    hfHighArusStable = false; 
    hfHighArusStartTime = 0;
  }
}

