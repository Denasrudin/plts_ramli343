void formatTanggalIndonesia(char *buffer, size_t bufferSize, time_t t) {
  struct tm* tmInfo = localtime(&t);
  snprintf(buffer, bufferSize, "%s, %02d-%02d-%04d %02d:%02d:%02d ",
           hariIndonesia[tmInfo->tm_wday], tmInfo->tm_mday, tmInfo->tm_mon + 1,
           tmInfo->tm_year + 1900, tmInfo->tm_hour, tmInfo->tm_min, tmInfo->tm_sec);
}

bool isWeatherTime() {
  if (!timeSynced) return false;
  time_t now = time(nullptr);
  struct tm* tmInfo = localtime(&now);
  return (tmInfo->tm_hour >= 6 && tmInfo->tm_hour < 17);
}

float hitungMedian(float *arr, int n) {
  float temp[FILTER_SAMPLES];
  for (int i = 0; i < n; i++) temp[i] = arr[i];
  for (int i = 0; i < n - 1; i++)
    for (int j = 0; j < n - i - 1; j++)
      if (temp[j] > temp[j + 1]) {
        float t = temp[j]; temp[j] = temp[j+1]; temp[j+1] = t;
      }
  return temp[n / 2];
}

void scanI2C() {
  Serial.println("[I2C] Scanning...");
  int nDevices = 0;
  for (byte addr = 1; addr < 127; addr++) {
    Wire.beginTransmission(addr);
    if (Wire.endTransmission() == 0) {
      Serial.printf("[I2C] Device found at 0x%02X\n", addr);
      nDevices++;
    }
  }
  if (nDevices == 0) Serial.println("[I2C] No devices found!");
}

// ============================================================
// MUTEX
// ============================================================
bool initializeMutexes() {
  if (mutexesReady) return true;
  
  Serial.println("[MUTEX] Initializing mutexes...");
  
  if (i2cMutex != NULL) {
    vSemaphoreDelete(i2cMutex);
    i2cMutex = NULL;
  }
  if (httpMutex != NULL) {
    vSemaphoreDelete(httpMutex);
    httpMutex = NULL;
  }
  
  esp_task_wdt_reset();
  
  i2cMutex = xSemaphoreCreateMutex();
  if (i2cMutex == NULL) {
    Serial.println("[FATAL] Failed to create i2cMutex!");
    return false;
  }
  
  esp_task_wdt_reset();
  
  httpMutex = xSemaphoreCreateMutex();
  if (httpMutex == NULL) {
    Serial.println("[FATAL] Failed to create httpMutex!");
    vSemaphoreDelete(i2cMutex);
    i2cMutex = NULL;
    return false;
  }
  
  mutexesReady = true;
  Serial.println("[MUTEX] ✓ Mutexes initialized successfully");
  return true;
}

