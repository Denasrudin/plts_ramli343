void updateLcdDisplay() {
  if (currentLcdPage != lastLcdPage) {
    if (TAKE_I2C((TickType_t)100)) { 
      lcd.clear(); 
      GIVE_I2C(); 
    }
    lastLcdPage = currentLcdPage;
  }

  float tegangan = batteryConnected ? teganganFiltered : 0.0f;
  float arusIn = batteryConnected ? fabs(arusInputFiltered) : 0.0f;
  float arusLoad = batteryConnected ? fabs(arusLoadFiltered) : 0.0f;
  bool wifiOK = (WiFi.status() == WL_CONNECTED);

