<div class="box">
<h2>UPDATE PLTS RAMLI343</h2>
<h3>Web OTA</h3>
<p>Firmware Saat Ini:<br><b id="firmwareVersion">)rawliteral" CURRENT_FIRMWARE_VERSION R"rawliteral(</b></p>

<form id="otaForm">
  <!-- Input file disembunyikan -->
  <input type="file" id="fileInput" name="update" accept=".bin" required style="display:none;">

  <!-- Tombol custom berbahasa Indonesia -->
  <button type="button" id="pilihFileBtn">Masukkan File</button>
  <div id="namaFile">Belum ada file dipilih</div>

  <br>
  <button type="submit" id="uploadButton">UPLOAD FIRMWARE</button>
</form>

<div id="progressBox">
  <div id="percent">0%</div>
  <div class="progressOuter"><div id="progressBar">0%</div></div>
  <div id="sizeInfo">0 KB / 0 KB</div>
  <div id="status">Menunggu upload...</div>
</div>

<div id="restartBox">
  <b>Box Sensor sedang restart...</b><br><br>
  <span id="restartText">Menunggu Box Sensor kembali online...</span>
</div>

<div id="doneBox">
  OTA SELESAI<br><br>
  Box Sensor sudah online kembali.<br>
  Firmware baru berhasil dijalankan.
</div>

