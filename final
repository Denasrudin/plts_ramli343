class RelayCallbacks : public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic *pChar) override {
    String cmd = pChar->getValue();
    cmd.trim();
    if (cmd.length() == 0) return;

    if (cmd.startsWith("SSID=")) pendingSsid = cmd.substring(5);
    else if (cmd.startsWith("PASS=")) pendingPass = cmd.substring(5);
    else if (cmd == "SAVE") {
      if (pendingSsid.length() > 0 && pendingPass.length() > 0) {
        preferences.begin("plts", false);
        preferences.putString("ssid", pendingSsid);
        preferences.putString("pass", pendingPass);
        preferences.end();
        delay(800);
        ESP.restart();
      }
    }
    else if (cmd == "RESET") {
      preferences.begin("plts", false);
      preferences.remove("ssid");
      preferences.remove("pass");
      preferences.end();
      delay(1000);
      ESP.restart();
    }
    else if (cmd == "RLY1_ON") {
      if (teganganPV >= PV_OVERRIDE_V) 
        Serial.printf("[BLE] RLY1_ON DITOLAK PV=%.1fV\n", teganganPV);
      else { 
        relay1Auto = false; 
        pln1Aktif = true; 
        digitalWrite(RELAY1_PIN, LOW); 
        lastRelay1Switch = millis(); 
        Serial.println("[BLE] LF MANUAL ON"); 
      }
    }
    else if (cmd == "RLY1_OFF") { 
      relay1Auto = false; 
      pln1Aktif = false; 
      digitalWrite(RELAY1_PIN, HIGH); 
      lastRelay1Switch = millis(); 
      Serial.println("[BLE] LF MANUAL OFF"); 
    }
    else if (cmd == "RLY1_AUTO") { 
      relay1Auto = true; 
      Serial.println("[BLE] LF AUTO"); 
    }
    else if (cmd == "RLY2_ON") {
      if (teganganPV >= PV_OVERRIDE_V) 
        Serial.printf("[BLE] RLY2_ON DITOLAK PV=%.1fV\n", teganganPV);
      else { 
        relay2Auto = false; 
        pln2Aktif = true; 
        digitalWrite(RELAY2_PIN, LOW); 
        lastRelay2Switch = millis(); 
        Serial.println("[BLE] HF MANUAL ON"); 
      }
    }
    else if (cmd == "RLY2_OFF") { 
      relay2Auto = false; 
      pln2Aktif = false; 
      digitalWrite(RELAY2_PIN, HIGH); 
      lastRelay2Switch = millis(); 
      Serial.println("[BLE] HF MANUAL OFF"); 
    }
    else if (cmd == "RLY2_AUTO") { 
      relay2Auto = true; 
      Serial.println("[BLE] HF AUTO"); 
    }
  }
};

