<p style="margin-top:35px;font-size:12px;color:#fff;">
Jangan matikan daya selama proses upload!<br><br>
denasrudin@gmail.com
</p>
</div>

<script>
var checkTimer=null,checkCount=0,maxChecks=40;
var fileInput=document.getElementById("fileInput");
var uploadButton=document.getElementById("uploadButton");
var progressBox=document.getElementById("progressBox");
var progressBar=document.getElementById("progressBar");
var percent=document.getElementById("percent");
var sizeInfo=document.getElementById("sizeInfo");
var statusBox=document.getElementById("status");
var restartBox=document.getElementById("restartBox");
var restartText=document.getElementById("restartText");
var doneBox=document.getElementById("doneBox");
var errorBox=document.getElementById("errorBox");
var errorText=document.getElementById("errorText");
var namaFileDiv=document.getElementById("namaFile");

function resetDisplay(){
  progressBox.style.display="none";
  restartBox.style.display="none";
  doneBox.style.display="none";
  errorBox.style.display="none";
  progressBar.style.width="0%";
  progressBar.innerHTML="0%";
  percent.innerHTML="0%";
  sizeInfo.innerHTML="0 KB / 0 KB";
  statusBox.innerHTML="Menunggu upload...";
}

function checkDevice(){
  checkCount++;
  restartText.innerHTML="Mencoba menghubungkan kembali... ("+checkCount+"/"+maxChecks+")";
  var xhr=new XMLHttpRequest();
  xhr.open("GET","/ota-status?t="+Date.now(),true);
  xhr.timeout=2000;
  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4)return;
    if(xhr.status===200){
      if(checkTimer){clearInterval(checkTimer);checkTimer=null;}
      restartText.innerHTML="Box Sensor sudah merespons kembali.";
      statusBox.innerHTML="Firmware baru sudah berjalan.";
      doneBox.style.display="block";
      errorBox.style.display="none";
      uploadButton.disabled=false;
      uploadButton.style.opacity="1";
    }
  };
  xhr.onerror=function(){};
  xhr.ontimeout=function(){};
  xhr.send();
  if(checkCount>=maxChecks){
    if(checkTimer){clearInterval(checkTimer);checkTimer=null;}
    restartText.innerHTML="Box Sensor belum merespons.";
    errorBox.style.display="block";
    errorText.innerHTML="Box Sensor belum merespons setelah "+maxChecks+" detik. Periksa Serial Monitor.";
    uploadButton.disabled=false;
    uploadButton.style.opacity="1";
  }
}

// Tombol "Masukkan File"
document.getElementById("pilihFileBtn").addEventListener("click",function(){
  fileInput.click();
});

// Tampilkan nama file yang dipilih
fileInput.addEventListener("change",function(){
  var file=this.files[0];
  if(file){
    namaFileDiv.innerHTML="File: <b style='color:#00ff00;'>"+file.name+"</b>";
  }else{
    namaFileDiv.innerHTML="Belum ada file dipilih";
  }
});

document.getElementById("otaForm").addEventListener("submit",function(e){
  e.preventDefault();
  var file=fileInput.files[0];
  if(!file){
    alert("Maaf, file salah!");
    return;
  }
  // Nama file rahasia
  if(file.name!=="update_plts.bin"){
    alert("Maaf, file salah!");
    fileInput.value="";
    namaFileDiv.innerHTML="Belum ada file dipilih";
    return;
  }
  if(checkTimer){clearInterval(checkTimer);checkTimer=null;}
  checkCount=0;
  progressBox.style.display="block";
  restartBox.style.display="none";
  doneBox.style.display="none";
  errorBox.style.display="none";
  uploadButton.disabled=true;
  uploadButton.style.opacity="0.5";
  progressBar.style.width="0%";
  progressBar.innerHTML="0%";
  percent.innerHTML="0%";
  sizeInfo.innerHTML="0 KB / "+(file.size/1024).toFixed(1)+" KB";
  statusBox.innerHTML="Mengupload ...";

  var xhr=new XMLHttpRequest();
  var formData=new FormData();
  formData.append("update",file);

  xhr.upload.addEventListener("progress",function(ev){
    if(!ev.lengthComputable)return;
    var p=Math.round((ev.loaded/ev.total)*100);
    if(p<0)p=0;if(p>100)p=100;
    progressBar.style.width=p+"%";
    progressBar.innerHTML=p+"%";
    percent.innerHTML=p+"%";
    sizeInfo.innerHTML=(ev.loaded/1024).toFixed(1)+" KB / "+(ev.total/1024).toFixed(1)+" KB";
    statusBox.innerHTML=(p<100)?"Mengupload firmware...":"Upload 100%. Memvalidasi firmware...";
  },false);

  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4)return;
    if(xhr.status===200){
      progressBar.style.width="100%";
      progressBar.innerHTML="100%";
      percent.innerHTML="100%";
      statusBox.innerHTML="Firmware berhasil diterima Box Sensor.";
      restartBox.style.display="block";
      restartText.innerHTML="Firmware valid. Box Sensor akan restart...";
      setTimeout(function(){
        restartText.innerHTML="Menunggu Box Sensor kembali online...";
        checkCount=0;
        if(checkTimer)clearInterval(checkTimer);
        checkTimer=setInterval(checkDevice,1000);
        checkDevice();
      },3000);
      return;
    }
    statusBox.innerHTML="OTA GAGAL.";
    errorBox.style.display="block";
    errorText.innerHTML="HTTP Error: "+xhr.status;
    uploadButton.disabled=false;
    uploadButton.style.opacity="1";
  };

  xhr.onerror=function(){
    statusBox.innerHTML="Koneksi terputus. Memeriksa Box Sensor...";
    restartBox.style.display="block";
    restartText.innerHTML="Memeriksa apakah Box Sensor sedang restart...";
    checkCount=0;
    if(checkTimer)clearInterval(checkTimer);
    checkTimer=setInterval(checkDevice,1000);
    setTimeout(checkDevice,2000);
  };

  xhr.ontimeout=function(){
    statusBox.innerHTML="Upload timeout. Memeriksa Box Sensor...";
    restartBox.style.display="block";
    restartText.innerHTML="Memeriksa apakah Box Sensor sedang restart...";
    checkCount=0;
    if(checkTimer)clearInterval(checkTimer);
    checkTimer=setInterval(checkDevice,1000);
    checkDevice();
  };

  xhr.open("POST","/update",true);
  xhr.timeout=300000;
  xhr.send(formData);
});

resetDisplay();
</script>
